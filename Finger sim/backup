    ea.AnalyticalLinearDamper,
    damping_constant=damping_constant,
    time_step=dt,
)
hinge_joint_sim.dampen(rod2).using(
    ea.AnalyticalLinearDamper,
    damping_constant=damping_constant,
    time_step=dt,
